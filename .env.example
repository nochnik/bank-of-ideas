DB_NAME=dmaic_db
DB_USER=dmaic_user
DB_PASSWORD=dmaic_pass

JWT_SECRET=replace-with-min-32-char-random-secret
JWT_EXPIRATION_MS=86400000

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password
# Optional demo participants. Keep real passwords in hosting secrets, not Git.
BOOTSTRAP_USERS_JSON=[{"username":"demo","password":"replace-me","fullName":"Demo User","position":"Participant"}]

# Production backend
PORT=8080
JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/dmaic_db
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,https://*.vercel.app
STORAGE_PATH=./data/uploads
PUBLIC_API_URL=http://localhost:8080

# Frontend build (set in Vercel)
VITE_API_URL=http://localhost:8080/api